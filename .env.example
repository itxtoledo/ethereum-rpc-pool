# Ethereum RPC endpoints example
# RPC_LIST=https://ethereum.publicnode.com,https://eth.llamarpc.com,https://rpc.ankr.com/eth

# BSC RPC endpoints example
RPC_LIST=https://binance.llamarpc.com,https://bsc-mainnet.gateway.tatum.io,https://bsc-rpc.publicnode.com

# Polygon RPC endpoints example
# RPC_LIST=https://polygon.llamarpc.com,https://polygon-bor.publicnode.com,https://polygon-rpc.com

# Server port
PORT=80

# Block number fetch interval in seconds
BLOCK_NUMBER_FETCH_INTERVAL_SECONDS=10

# CORS: "*" allows every origin (default); or a comma-separated list
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=*

# Retries: upstream tries per request, backoff, per-call and total timeouts
# RPC_MAX_ATTEMPTS=3
# RPC_RETRY_BACKOFF_MS=100
# UPSTREAM_TIMEOUT_SECONDS=10
# REQUEST_TIMEOUT_SECONDS=25

# Logging: debug | info | warn | error. LOG_BODIES (debug only) logs request/response bodies.
# LOG_LEVEL=debug
# LOG_BODIES=true
# LOG_BODY_MAX_BYTES=65536
